[Unit]
Description=Recover USB enclosure from boot-time USB 2.0 fallback (ASM2464PD MCU reset)
DefaultDependencies=no
# Let fstab mount the SSD first, then finish recovery before filesystems and
# Docker-backed applications are considered ready.
Wants=mnt-external_ssd.mount
After=mnt-external_ssd.mount
Before=local-fs.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/usb-reset.sh
User=root
# A failure leaves the SSD unmounted and prevents Docker from starting.
TimeoutStartSec=120

[Install]
WantedBy=local-fs.target
RequiredBy=docker.service
